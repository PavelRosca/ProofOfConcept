# Django Settings
DEBUG=True
PUBLIC_DEMO=False
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/party_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Feature flags
ENABLE_DONATIONS_API=False

# Security (set these for public deployment)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email Settings
# Dev (DEBUG=True, PUBLIC_DEMO=False): backend is forced to console.EmailBackend in settings.py,
# emails print to the runserver terminal — leave EMAIL_HOST/USER/PASSWORD blank.
# Production (DEBUG=False or PUBLIC_DEMO=True): set real SMTP creds below (any provider works —
# Gmail, SendGrid, Mailgun, SES, or the Aruba VPS's own mailbox).
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Stripe (Phase 6 — not yet implemented, placeholders only)
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# AWS S3 (optional - for media storage)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
